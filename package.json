{
  "name": "linux-cbt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-v86-assets.mjs",
    "predev": "node scripts/copy-v86-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-v86-assets.mjs",
    "build": "tsc -b && vite build && node scripts/prune-image.mjs dist debian",
    "build:staging": "tsc -b && vite build --mode staging --outDir dist-staging && node scripts/prune-image.mjs dist-staging debian",
    "preview": "vite preview",
    "deploy": "node scripts/deploy.mjs",
    "deploy:staging": "node scripts/deploy.mjs staging",
    "test": "vitest run"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "v86": "^0.5.432"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
